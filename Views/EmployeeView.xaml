<UserControl x:Class="EmployeeManagementSystem.Views.EmployeeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="13"/>
                    <TextBlock Text="Search by name, CNIC, designation, department, status..."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Button Grid.Column="1" Content="Export CSV" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ExportCommand}" Margin="10,0,0,0" Padding="14,8"/>
            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource CardBorder}" Padding="20,20,20,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Employee" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                    <TextBlock Text="Full Name" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>

                    <TextBlock Text="CNIC" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Text="{Binding CNIC, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>

                    <TextBlock Text="Designation" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Text="{Binding Designation, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>

                    <TextBlock Text="Department" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox ItemsSource="{Binding Departments}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedDepartment}" Margin="0,4,0,12" Padding="6"/>

                    <TextBlock Text="Joining Date" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <DatePicker SelectedDate="{Binding JoiningDate}" Margin="0,4,0,12"/>

                    <TextBlock Text="Biometric ID" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Text="{Binding BiometricId, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>

                    <TextBlock Text="Status" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox SelectedValuePath="Content" SelectedValue="{Binding Status}" Margin="0,4,0,16" Padding="6">
                        <ComboBoxItem Content="Active"/>
                        <ComboBoxItem Content="Inactive"/>
                    </ComboBox>

                    <UniformGrid Columns="2" Rows="2">
                        <Button Content="Add" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" Margin="0,0,6,6"/>
                        <Button Content="Update" Style="{StaticResource PrimaryButton}" Command="{Binding UpdateCommand}" Margin="6,0,0,6"/>
                        <Button Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" Margin="0,0,6,0"/>
                        <Button Content="Clear" Style="{StaticResource SecondaryButton}" Command="{Binding ClearCommand}" Margin="6,0,0,0"/>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardBorder}">
            <DataGrid ItemsSource="{Binding EmployeesView}"
                      SelectedItem="{Binding SelectedEmployee}"
                      IsReadOnly="True"
                      HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding EmployeeId}" Width="50"/>
                    <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="180" MinWidth="140"/>
                    <DataGridTextColumn Header="CNIC" Binding="{Binding CNIC}" Width="150"/>
                    <DataGridTextColumn Header="Designation" Binding="{Binding Designation}" Width="140"/>
                    <DataGridTextColumn Header="Department" Binding="{Binding DepartmentName}" Width="120"/>
                    <DataGridTextColumn Header="Joined" Binding="{Binding JoiningDate, StringFormat=dd-MMM-yyyy}" Width="110"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>