<UserControl x:Class="EmployeeManagementSystem.Views.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left panel: lookup + manual punch -->
        <StackPanel Grid.Column="0">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Attendance Lookup" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                    <TextBlock Text="Employee" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox ItemsSource="{Binding Employees}" DisplayMemberPath="FullName"
                              SelectedItem="{Binding SelectedEmployee}" Margin="0,4,0,12" Padding="6"/>

                    <TextBlock Text="From" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <DatePicker SelectedDate="{Binding FromDate}" Margin="0,4,0,12"/>

                    <TextBlock Text="To" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <DatePicker SelectedDate="{Binding ToDate}" Margin="0,4,0,16"/>

                    <Button Content="Search" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Manual Punch" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="Records current date/time for the selected employee above."
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <UniformGrid Columns="2">
                        <Button Content="Punch In" Style="{StaticResource PrimaryButton}"
                                Command="{Binding PunchInCommand}" Margin="0,0,6,0"/>
                        <Button Content="Punch Out" Style="{StaticResource DangerButton}"
                                Command="{Binding PunchOutCommand}" Margin="6,0,0,0"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Right panel: daily summary + raw punches -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <TextBlock Text="Daily Summary" FontSize="14" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,10"/>
                    <DataGrid ItemsSource="{Binding DailySummaries}" IsReadOnly="True" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd-MMM-yyyy}" Width="130"/>
                            <DataGridTextColumn Header="First In" Binding="{Binding FirstIn, StringFormat=hh\\:mm tt}" Width="110"/>
                            <DataGridTextColumn Header="Last Out" Binding="{Binding LastOut, StringFormat=hh\\:mm tt}" Width="110"/>
                            <DataGridTextColumn Header="Hours Worked" Binding="{Binding HoursWorked}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Raw Punches" FontSize="14" FontWeight="Bold"/>
                        <Button Content="Delete Selected" Style="{StaticResource DangerButton}"
                                Command="{Binding DeletePunchCommand}" HorizontalAlignment="Right"
                                DockPanel.Dock="Right" Padding="12,6"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding RawPunches}"
                              SelectedItem="{Binding SelectedPunch}"
                              IsReadOnly="True" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date/Time" Binding="{Binding PunchTime, StringFormat=dd-MMM-yyyy hh:mm tt}" Width="180"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding PunchType}" Width="80"/>
                            <DataGridTextColumn Header="Device" Binding="{Binding DeviceId}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>