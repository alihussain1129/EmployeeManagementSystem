<Window x:Class="EmployeeManagementSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EmployeeManagementSystem.ViewModels"
        xmlns:views="clr-namespace:EmployeeManagementSystem.Views"
        Title="Employee Management System" Height="700" Width="1150"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmployeeViewModel}">
            <views:EmployeeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SalaryViewModel}">
            <views:SalaryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AttendanceViewModel}">
            <views:AttendanceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DepartmentViewModel}">
            <views:DepartmentView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,20,0,0">
                    <TextBlock Text="EMS" Foreground="White" FontSize="22" FontWeight="Bold"
                               Margin="20,0,0,30"/>

                    <Button Content="Dashboard" Command="{Binding ShowDashboardCommand}"
                            Style="{StaticResource SecondaryButton}" Background="Transparent"
                            Foreground="White" FontSize="14"
                            HorizontalContentAlignment="Left"
                            Margin="10,4" Padding="20,10"/>
                    <Button Content="Employees" Command="{Binding ShowEmployeeCommand}"
                            Style="{StaticResource SecondaryButton}" Background="Transparent"
                            Foreground="White" FontSize="14"
                            HorizontalContentAlignment="Left"
                            Margin="10,4" Padding="20,10"/>
                    <Button Content="Salaries" Command="{Binding ShowSalaryCommand}"
                            Style="{StaticResource SecondaryButton}" Background="Transparent"
                            Foreground="White" FontSize="14"
                            HorizontalContentAlignment="Left"
                            Margin="10,4" Padding="20,10"/>
                    <Button Content="Attendance" Command="{Binding ShowAttendanceCommand}"
                            Style="{StaticResource SecondaryButton}" Background="Transparent"
                            Foreground="White" FontSize="14"
                            HorizontalContentAlignment="Left"
                            Margin="10,4" Padding="20,10"/>
                    <Button Content="Departments" Command="{Binding ShowDepartmentCommand}"
                            Style="{StaticResource SecondaryButton}" Background="Transparent"
                            Foreground="White" FontSize="14"
                            HorizontalContentAlignment="Left"
                            Margin="10,4" Padding="20,10"/>
                </StackPanel>

                <!-- User info + logout -->
                <Border Grid.Row="1" BorderBrush="#2C4160" BorderThickness="0,1,0,0" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentUser.FullName}" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding CurrentUser.Role}" Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,10"/>
                        <Button Content="Logout" Command="{Binding LogoutCommand}"
                                Style="{StaticResource DangerButton}" FontSize="13"
                                HorizontalAlignment="Stretch" Padding="10,8"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Content -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="0"/>
    </Grid>
</Window>